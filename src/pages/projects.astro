---
import { getCollection } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={`Projects — ${SITE_TITLE}`} description="Things I've built.">
  <div class="max-w-5xl mx-auto w-full px-6 py-14 md:py-20">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }]} current="Projects" />

    <header class="mb-12 animate-fade-up">
      <h1 class="font-serif text-4xl md:text-5xl font-500 tracking-[-0.015em] text-ink mb-3">
        Projects
      </h1>
      <p class="font-serif text-lg text-ink-muted max-w-xl">
        Libraries and tools I've built and maintain — small, typed, and meant to
        be read.
      </p>
    </header>

    <div class="border-t border-line">
      {
        projects.map((project) => (
          <a
            href={project.data.href}
            target="_blank"
            rel="noopener noreferrer"
            class="post-row group block py-7 border-b border-line no-underline"
          >
            <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8">
              <div class="md:w-56 shrink-0">
                <h2 class="font-serif text-xl font-500 text-ink group-hover:text-green transition-colors duration-200 leading-tight">
                  {project.data.title}
                </h2>
                <div class="flex items-center gap-2.5 mt-1.5 text-mini font-mono text-ink-faint">
                  <span>{project.data.status}</span>
                  <span class="text-line">/</span>
                  <span>{project.data.year}</span>
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-serif text-lg text-ink-muted leading-relaxed mb-3">
                  {project.data.description}
                </p>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  {project.data.tech.map((t) => (
                    <span class="text-mini font-mono text-ink-faint">{t}</span>
                  ))}
                </div>
              </div>
              <div class="hidden md:flex items-baseline shrink-0 pt-1">
                <Icon
                  name="arrow-external"
                  class="w-4 h-4 text-ink-faint group-hover:text-green group-hover:translate-x-0.5 transition-all duration-200"
                />
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
