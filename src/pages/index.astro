---
import { getCollection } from 'astro:content';
import EmptyState from '../components/EmptyState.astro';
import Icon from '../components/Icon.astro';
import PostRow from '../components/PostRow.astro';
import WireframeCanvas from '../components/WireframeCanvas.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AVAILABILITY, SITE_DESCRIPTION, SITE_TITLE, TECH_STACK } from '../consts';
import { getPublishedPosts } from '../utils/posts';
import { getReadingTime } from '../utils/reading-time';

const allPosts = await getPublishedPosts();
const [featured, ...rest] = allPosts;
const morePosts = rest.slice(0, 5);
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 pt-16 md:pt-24 pb-16 md:pb-20">
    <div class="flex flex-col md:flex-row md:items-center gap-10 md:gap-8">
      <div class="flex-1 max-w-xl animate-fade-up">
        <p class="text-body-sm text-ink-faint mb-6">Frontend engineer</p>
        <h1
          class="font-serif text-4xl md:text-[3.75rem] font-500 leading-[1.08] tracking-[-0.015em] text-ink mb-6"
        >
          I build web interfaces, and write about the parts worth remembering.
        </h1>
        <p class="font-serif text-lg md:text-xl text-ink-muted leading-relaxed max-w-lg">
          Mostly TypeScript — the language, the browser, and the small decisions
          that decide whether an interface holds up over time.
        </p>
        <div class="flex flex-wrap gap-x-4 gap-y-1.5 mt-8">
          {
            TECH_STACK.slice(0, 5).map((t) => (
              <span class="text-body-sm text-ink-faint">{t}</span>
            ))
          }
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-3">
          {
            AVAILABILITY.open && (
              <span class="inline-flex items-center gap-2 text-body-sm text-ink-muted">
                <span class="w-1.5 h-1.5 rounded-full bg-green" />
                {AVAILABILITY.label}
              </span>
            )
          }
          <a
            href="/work"
            class="group inline-flex items-center gap-1.5 text-body-sm text-ink no-underline transition-colors hover:text-green"
          >
            Work with me
            <span
              class="transition-transform duration-200 group-hover:translate-x-0.5"
              >&rarr;</span
            >
          </a>
        </div>
      </div>
      <div class="flex-shrink-0 animate-fade-in" style="animation-delay: 200ms;">
        <WireframeCanvas
          posts={allPosts.slice(0, 5).map((p) => ({
            title: p.data.title,
            slug: p.id,
            date: p.data.pubDate.toLocaleDateString('en-US', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            }),
          }))}
        />
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="max-w-5xl mx-auto px-6 py-14 border-t border-line">
    <div class="flex items-baseline justify-between mb-10">
      <h2 class="text-body-sm text-ink-muted">Writing</h2>
      <a
        href="/blog"
        class="text-body-sm text-ink-faint hover:text-ink no-underline transition-colors"
        >All essays &rarr;</a
      >
    </div>

    {
      featured ? (
        <a
          href={`/blog/${featured.id}/`}
          class="group block no-underline mb-4"
        >
          <div class="flex items-center gap-2.5 text-mini font-mono text-ink-faint mb-3">
            <time datetime={featured.data.pubDate.toISOString()}>
              {featured.data.pubDate.toLocaleDateString('en-us', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </time>
            <span class="text-line">/</span>
            <span>{getReadingTime(featured.body ?? '')} min read</span>
            {featured.data.series && (
              <>
                <span class="text-line">/</span>
                <span>
                  Part {featured.data.series.part} of {featured.data.series.total}
                </span>
              </>
            )}
          </div>
          <h3 class="font-serif text-2xl md:text-[2rem] font-500 leading-[1.15] tracking-[-0.01em] text-ink group-hover:text-green transition-colors duration-200 mb-3 max-w-2xl">
            {featured.data.title}
          </h3>
          <p class="font-serif text-lg text-ink-muted leading-relaxed max-w-2xl">
            {featured.data.description}
          </p>
        </a>
      ) : (
        <EmptyState message="No essays yet." />
      )
    }

    {
      morePosts.length > 0 && (
        <div class="mt-12 pt-2 border-t border-line">
          {morePosts.map((post) => (
            <PostRow
              id={post.id}
              title={post.data.title}
              pubDate={post.data.pubDate}
              body={post.body}
              series={post.data.series}
            />
          ))}
        </div>
      )
    }
  </section>

  <!-- Projects -->
  <section class="max-w-5xl mx-auto px-6 py-14 border-t border-line">
    <div class="flex items-baseline justify-between mb-10">
      <h2 class="text-body-sm text-ink-muted">Projects</h2>
      <a
        href="/projects"
        class="text-body-sm text-ink-faint hover:text-ink no-underline transition-colors"
        >All projects &rarr;</a
      >
    </div>
    <div>
      {
        projects.map((p) => (
          <a
            href={p.data.href}
            target="_blank"
            rel="noopener noreferrer"
            class="post-row group flex items-baseline justify-between gap-4 py-4 border-b border-line/60 no-underline"
          >
            <div class="min-w-0">
              <div class="flex items-baseline gap-2.5 flex-wrap">
                <span class="font-serif text-lg font-500 text-ink group-hover:text-green transition-colors duration-200">
                  {p.data.title}
                </span>
                <span class="text-mini font-mono text-ink-faint">
                  {p.data.status === 'Live' ? 'Live' : p.data.status}
                </span>
              </div>
              <p class="text-body-sm text-ink-muted leading-relaxed mt-1 max-w-xl">
                {p.data.description}
              </p>
            </div>
            <div class="flex items-center gap-3 shrink-0 pt-1">
              <span class="text-mini font-mono text-ink-faint hidden sm:block">
                {p.data.year}
              </span>
              <Icon
                name="arrow-external"
                class="w-3.5 h-3.5 text-ink-faint group-hover:text-green transition-colors"
              />
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Work with me -->
  <section class="max-w-5xl mx-auto px-6 py-16 border-t border-line">
    <div class="max-w-2xl">
      <h2 class="text-body-sm text-ink-muted mb-5">Work with me</h2>
      <p
        class="font-serif text-2xl md:text-[1.75rem] font-500 leading-[1.2] tracking-[-0.01em] text-ink mb-6"
      >
        I take on a few freelance projects a year — the kind where the frontend
        is the hard part.
      </p>
      <a
        href="/work"
        class="group inline-flex items-center gap-1.5 text-body-sm text-ink no-underline transition-colors hover:text-green"
      >
        What I do &amp; how to reach me
        <span
          class="transition-transform duration-200 group-hover:translate-x-0.5"
          >&rarr;</span
        >
      </a>
    </div>
  </section>
</BaseLayout>
