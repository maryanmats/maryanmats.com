---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EmptyState from '../../components/EmptyState.astro';
import PostRow from '../../components/PostRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const grouped = posts.reduce<Record<number, typeof posts>>((acc, post) => {
  const year = post.data.pubDate.getFullYear();
  (acc[year] ??= []).push(post);
  return acc;
}, {});
const years = Object.keys(grouped)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title={`Blog — ${SITE_TITLE}`}
  description="Articles about TypeScript, React, and the modern web."
>
  <div class="max-w-5xl mx-auto w-full px-6 py-14 md:py-20">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }]} current="Blog" />

    <header class="mb-10 animate-fade-up">
      <h1 class="font-serif text-4xl md:text-5xl font-500 tracking-[-0.015em] text-ink mb-3">
        Writing
      </h1>
      <p class="font-serif text-lg text-ink-muted max-w-xl">
        Essays on TypeScript, the browser, and the craft of building interfaces.
      </p>
    </header>

    {
      allTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 mb-12 pb-6 border-b border-line">
          {allTags.map((tag) => (
            <a
              href={`/blog/tag/${tag}/`}
              class="text-body-sm font-mono text-ink-faint no-underline hover:text-green transition-colors duration-200"
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    {
      posts.length === 0 ? (
        <EmptyState />
      ) : (
        years.map((year) => (
          <section class="mb-10">
            <h2 class="text-body-sm font-mono text-ink-faint mb-4 flex items-center gap-3">
              <span>{year}</span>
              <span class="flex-1 h-px bg-line" />
            </h2>
            <div>
              {grouped[year].map((post) => (
                <PostRow
                  id={post.id}
                  title={post.data.title}
                  pubDate={post.data.pubDate}
                  body={post.body}
                  series={post.data.series}
                  dateFormat="short"
                />
              ))}
            </div>
          </section>
        ))
      )
    }
  </div>
</BaseLayout>
