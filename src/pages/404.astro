---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Maryan Mats" description="Page not found.">
  <div class="max-w-5xl mx-auto px-6 py-32 text-center">
    <p class="text-body-sm font-mono text-ink-faint mb-5">404</p>
    <h1 class="font-serif text-4xl md:text-6xl font-500 tracking-[-0.015em] text-ink mb-4">
      Page not found
    </h1>
    <p class="font-serif text-lg text-ink-muted mb-10 max-w-md mx-auto">
      The page you're looking for doesn't exist, or it has moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 text-body-md text-green no-underline hover:text-green-hover transition-colors"
    >
      <Icon name="arrow-left" class="w-4 h-4" />
      Back to home
    </a>
  </div>
</BaseLayout>
