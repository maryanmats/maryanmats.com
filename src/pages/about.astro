---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactLinks from '../components/ContactLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, TECH_STACK } from '../consts';
---

<BaseLayout
  title={`About — ${SITE_TITLE}`}
  description="Maryan Mats — a frontend engineer working in TypeScript, React, and the modern web."
>
  <div class="max-w-5xl mx-auto w-full px-6 py-14 md:py-20">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }]} current="About" />

    <header class="mb-12 animate-fade-up">
      <p class="text-body-sm text-ink-faint mb-4">About</p>
      <h1 class="font-serif text-4xl md:text-5xl font-500 tracking-[-0.015em] text-ink">
        Maryan Mats
      </h1>
    </header>

    <div class="grid md:grid-cols-[1.6fr_1fr] gap-12 md:gap-16">
      <!-- Bio -->
      <div class="font-serif text-lg md:text-xl text-ink leading-relaxed space-y-6 max-w-xl">
        <p>
          I'm a frontend engineer based in Ukraine. I work mostly in TypeScript —
          building interfaces with React, Next.js, and Astro, and paying
          attention to the layer most people skip past: the types, the edge
          cases, the moment an interaction either feels right or doesn't.
          Increasingly that means working alongside AI — fast on the keys,
          deliberate about what ships.
        </p>
        <p>
          This is where I write it down. Most essays start as something I had to
          figure out at work — a pattern that finally clicked, an API I'd misread
          for years, a decision I'd argue for now. A few ship with small
          libraries you can install and read in one sitting.
        </p>
      </div>

      <!-- Side rail -->
      <aside class="space-y-10">
        <section>
          <h2 class="text-body-sm font-medium text-ink-muted mb-3">Stack</h2>
          <p class="font-serif text-lg text-ink leading-relaxed">
            {TECH_STACK.join(', ')}.
          </p>
        </section>

        <section>
          <h2 class="text-body-sm font-medium text-ink-muted mb-3">Elsewhere</h2>
          <ContactLinks />
        </section>

        <section>
          <h2 class="text-body-sm font-medium text-ink-muted mb-3">Based in</h2>
          <p class="font-serif text-lg text-ink">Ukraine · Remote</p>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>
