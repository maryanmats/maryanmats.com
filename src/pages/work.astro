---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  AVAILABILITY,
  SITE_EMAIL,
  SITE_TITLE,
  SOCIAL_LINKS,
} from '../consts';
import { getPublishedPosts } from '../utils/posts';

const OFFERINGS = [
  {
    title: 'Build',
    kicker: 'Product & frontend work',
    description:
      'Greenfield builds or rescue work — shipped, typed, and readable long after the project ends. React, Next.js, Astro, TypeScript. I use the current tooling to move quickly; the parts that decide whether it holds up still get a senior’s attention.',
  },
  {
    title: 'Advise',
    kicker: 'Architecture, types & AI workflow',
    description:
      'A second pair of eyes on architecture and types — and, increasingly, on how a team actually gets value out of AI tools like Claude Code without drowning the codebase in plausible-looking debt.',
  },
];

const proofPosts = (await getPublishedPosts())
  .filter((p) => p.data.tags?.includes('claude-code'))
  .slice(0, 2);
---

<BaseLayout
  title={`Work with me — ${SITE_TITLE}`}
  description="Freelance frontend work — React, Next.js, TypeScript, and design systems, built to last."
>
  <div class="max-w-5xl mx-auto w-full px-6 py-14 md:py-20">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }]} current="Work" />

    <header class="mb-14 animate-fade-up">
      <p class="text-body-sm text-ink-faint mb-4">Work</p>
      <h1 class="font-serif text-4xl md:text-5xl font-500 tracking-[-0.015em] text-ink mb-5">
        Work with me
      </h1>
      <p class="font-serif text-lg md:text-xl text-ink-muted leading-relaxed max-w-xl mb-6">
        I'm a senior frontend engineer — TypeScript, React, Next.js, Astro. I
        build products and advise teams on the frontend, and I take on a small
        number of engagements a year.
      </p>
      {
        AVAILABILITY.open && (
          <p class="inline-flex items-center gap-2 text-body-sm text-ink-muted">
            <span class="w-1.5 h-1.5 rounded-full bg-green" />
            {AVAILABILITY.label}
          </p>
        )
      }
    </header>

    <!-- What I do -->
    <section class="mb-14">
      <h2 class="text-body-sm text-ink-muted mb-6">What I do</h2>
      <div class="border-t border-line">
        {
          OFFERINGS.map((o) => (
            <div class="py-7 border-b border-line flex flex-col md:flex-row gap-2 md:gap-8">
              <div class="md:w-56 shrink-0">
                <h3 class="font-serif text-xl font-500 text-ink leading-tight">
                  {o.title}
                </h3>
                <p class="text-mini font-mono text-ink-faint mt-1.5">
                  {o.kicker}
                </p>
              </div>
              <p class="flex-1 font-serif text-lg text-ink-muted leading-relaxed max-w-xl">
                {o.description}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- How I work -->
    <section class="mb-14">
      <h2 class="text-body-sm text-ink-muted mb-6">How I work</h2>
      <div class="font-serif text-lg text-ink leading-relaxed space-y-4 max-w-xl">
        <p>
          Small scope, clear deliverables, typed and tested — code the next
          person can read. I use AI tooling heavily but review every line like a
          senior; nothing ships because it looked right.
        </p>
        <p>
          I work remotely from Ukraine, in your team's overlap hours. Everything
          on this site is written by me — which is about the bar for how I'll
          communicate on your project.
        </p>
      </div>
    </section>

    <!-- Selected writing -->
    {
      proofPosts.length > 0 && (
        <section class="mb-14">
          <h2 class="text-body-sm text-ink-muted mb-6">See how I think</h2>
          <p class="font-serif text-lg text-ink-muted leading-relaxed max-w-xl mb-6">
            No testimonials wall — just a blog, on how I build and how I work
            with these tools. A place to start:
          </p>
          <ul class="border-t border-line max-w-xl">
            {proofPosts.map((post) => (
              <li>
                <a
                  href={`/blog/${post.id}/`}
                  class="group flex items-baseline justify-between gap-4 py-4 border-b border-line no-underline"
                >
                  <span class="font-serif text-lg font-500 text-ink group-hover:text-green transition-colors duration-200">
                    {post.data.title}
                  </span>
                  <span class="shrink-0 text-ink-faint group-hover:text-green group-hover:translate-x-0.5 transition-all duration-200">
                    &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Start a project -->
    <section>
      <h2 class="text-body-sm text-ink-muted mb-6">Start a project</h2>
      <p class="font-serif text-lg text-ink-muted leading-relaxed max-w-xl mb-6">
        Tell me what you're building or what your team needs, the rough scope,
        and your timeline. Email's best; I usually reply within a day or two.
      </p>
      <a
        href={`mailto:${SITE_EMAIL}`}
        class="group inline-flex items-center gap-2.5 rounded-lg border border-line bg-panel px-5 py-3 font-mono text-body-sm text-ink no-underline transition-colors hover:border-green hover:text-green"
      >
        <Icon name="mail" class="w-4 h-4" />
        {SITE_EMAIL}
      </a>
      <div class="mt-8">
        <p class="text-body-sm text-ink-faint mb-3">Or find me on</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {
            SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-body-sm text-ink-muted hover:text-green no-underline transition-colors"
                >
                  <Icon name={link.icon} class="w-3.5 h-3.5" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
