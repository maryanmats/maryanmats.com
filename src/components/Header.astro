---
import Icon from './Icon.astro';
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS } from '../consts';

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^/]+/g);
const current = '/' + (subpath?.[0] || '');
---

<header class="header-root sticky top-0 z-50">
  <div class="header-bg absolute inset-0 bg-page/80 backdrop-blur-xl"></div>
  <div class="header-line absolute bottom-0 left-0 right-0 h-px bg-line"></div>

  <nav
    aria-label="Main navigation"
    class="relative max-w-5xl mx-auto flex items-center justify-between px-6 h-16"
  >
    <!-- Wordmark -->
    <a
      href="/"
      class="logo-root no-underline"
      aria-label="Maryan Mats — home"
    >
      <span
        class="font-serif text-[1.3rem] font-500 tracking-[-0.01em] text-ink transition-colors duration-200 hover:text-green"
        >Maryan Mats</span
      >
    </a>

    <!-- Desktop nav -->
    <div class="hidden sm:flex items-center gap-6">
      {
        NAV_LINKS.map((link) => {
          const isActive = link.href === current || link.href === pathname;
          return (
            <a
              href={link.href}
              class:list={[
                'nav-item relative text-body-sm no-underline transition-colors duration-200',
                isActive
                  ? 'text-ink'
                  : 'text-ink-faint hover:text-ink',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
              <span
                class:list={[
                  'absolute -bottom-1.5 left-0 h-px bg-green transition-all duration-200',
                  isActive ? 'w-full opacity-100' : 'w-0 opacity-0',
                ]}
              />
            </a>
          );
        })
      }
    </div>

    <!-- Right cluster -->
    <div class="flex items-center gap-3">
      <Search />
      <a
        href="/rss.xml"
        class="hidden sm:flex items-center gap-1.5 text-ink-faint hover:text-green transition-colors duration-200 no-underline"
        aria-label="RSS feed"
      >
        <Icon name="rss" class="w-3.5 h-3.5" />
        <span class="text-body-sm">RSS</span>
      </a>
      <div class="w-px h-3.5 bg-line hidden sm:block"></div>
      <ThemeToggle />

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="sm:hidden flex items-center justify-center w-8 h-8 text-ink-faint hover:text-green transition-colors cursor-pointer"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg
          class="hamburger-icon w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 9h16.5m-16.5 6.75h16.5"></path>
        </svg>
        <svg
          class="close-icon w-5 h-5 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="mobile-menu sm:hidden hidden relative border-t border-line bg-page/95 backdrop-blur-xl"
  >
    <div class="max-w-5xl mx-auto px-6 py-4 space-y-1">
      {
        NAV_LINKS.map((link) => {
          const isActive = link.href === current || link.href === pathname;
          return (
            <a
              href={link.href}
              class:list={[
                'block py-2.5 text-sm no-underline transition-colors',
                isActive
                  ? 'text-green'
                  : 'text-ink-muted hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href="/rss.xml"
        class="flex items-center gap-2 py-2.5 text-sm text-ink-muted hover:text-green no-underline transition-colors"
      >
        <Icon name="rss" class="w-3.5 h-3.5" />
        RSS feed
      </a>
    </div>
  </div>
</header>

<script>
  let cleanup: (() => void) | null = null;

  function initMobileMenu() {
    cleanup?.();

    const btn = document.getElementById('mobile-menu-btn');
    const menuEl = document.getElementById('mobile-menu');
    if (!btn || !menuEl) {
      return;
    }

    const hamburgerIcon = btn.querySelector('.hamburger-icon');
    const closeIcon = btn.querySelector('.close-icon');

    function toggle() {
      const isOpen = !menuEl!.classList.contains('hidden');
      menuEl!.classList.toggle('hidden');
      hamburgerIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
      btn!.setAttribute('aria-expanded', String(!isOpen));
    }

    function closeMenu() {
      menuEl!.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      btn!.setAttribute('aria-expanded', 'false');
    }

    btn.addEventListener('click', toggle);
    const links = menuEl.querySelectorAll('a');
    links.forEach((a) => a.addEventListener('click', closeMenu));

    cleanup = () => {
      btn!.removeEventListener('click', toggle);
      links.forEach((a) => a.removeEventListener('click', closeMenu));
    };
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
